#!/bin/sh
#
# Checks a commit message, which check-boundary does not read. A closing line
# that is neither a trailer nor a link is left to the writer.

set -eu

# --record is the exception, so a caller that forgets it gets the stricter rule.
MODE=engine
if [ "${1:-}" = "--record" ]; then
    MODE=record
    shift
fi
MSG_FILE="${1:?usage: check-message-metadata [--record] <message-file>}"

# Said on every message however the check ends, because a silent pass reads like a complete one.
trap 'echo "  not examined: a closing line that is neither a trailer nor a link (left to the writer)" >&2' EXIT

# An allowlist, so a key nobody has thought of is already refused.
ALLOWED='bench'

CLEAN=$(git stripspace --strip-comments < "$MSG_FILE")

# git's own parse, so this agrees with git, and it catches the lower-case keys
# the pass below misses.
KEYS=$(
    printf '%s\n' "$CLEAN" |
    git interpret-trailers --parse |
    sed -n 's/^\([A-Za-z][A-Za-z0-9-]*\)[ ]*:.*/\1/p' |
    tr '[:upper:]' '[:lower:]'
)

rc=0

for key in $KEYS; do
    allowed=0
    for ok in $ALLOWED; do
        if [ "$key" = "$ok" ]; then
            allowed=1
        fi
    done
    if [ "$allowed" -eq 0 ]; then
        echo "commit message: \"$key\" is not a trailer key this repository uses." >&2
        rc=1
    fi
done

# Every line but the subject, because git reads only the last paragraph; a
# capitalised key is what separates a trailer from prose that wrapped at a colon.
ANYWHERE=$(
    printf '%s\n' "$CLEAN" |
    tail -n +2 |
    sed -n 's/^\([A-Z][A-Za-z0-9-]*\)[ ]*:[ 	].*/\1/p' |
    tr '[:upper:]' '[:lower:]'
)

for key in $ANYWHERE; do
    allowed=0
    for ok in $ALLOWED; do
        if [ "$key" = "$ok" ]; then
            allowed=1
        fi
    done
    if [ "$allowed" -eq 0 ]; then
        echo "commit message: \"$key\" is not a trailer key this repository uses." >&2
        echo "            It is not in the trailer block, so \`git interpret-trailers\`" >&2
        echo "            does not see it. This check reads every line for that reason." >&2
        echo "            If the line is prose, write it so it does not open \"Word:\"." >&2
        rc=1
    fi
done

# Links are refused because their targets are someone else's to change.
LINK=$(printf '%s\n' "$CLEAN" | grep -inE '[a-z][a-z0-9+.-]*://|www\.[a-z0-9-]+\.[a-z]' | head -n 1 || true)
if [ -n "$LINK" ]; then
    echo "commit message: a link on line $LINK" >&2
    rc=1
fi

# One digit is a square, not a finding.
if [ "$MODE" = engine ]; then
    CITE=$(printf '%s\n' "$CLEAN" |
        grep -nE '(^|[^A-Za-z0-9_])ADRs?([^A-Za-z_]|$)|(^|[^A-Za-z0-9_])F[0-9]{2,3}([^A-Za-z0-9_]|$)' |
        head -n 1 || true)
    if [ -n "$CITE" ]; then
        echo "commit message: a record or finding citation on line $CITE" >&2
        echo "            This tree does not hold the records, so write the reason instead." >&2
        rc=1
    fi
fi
if [ "$rc" -eq 0 ]; then
    exit 0
fi

echo "" >&2
echo "            A message here carries the subject, the body, and a trailer" >&2
echo "            block using the keys in \`check-message-metadata\`. References" >&2
echo "            are named rather than linked." >&2
echo "" >&2
echo "            This repository is published, and a message is published with" >&2
echo "            it. Unlike a file it cannot be corrected by the next commit:" >&2
echo "            the only fix is to rewrite history, and once the branch is" >&2
echo "            somewhere else that is no fix. So the line comes out before" >&2
echo "            the commit, not after." >&2
exit "$rc"
