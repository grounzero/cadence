#!/bin/sh
#
# Checks a commit message, which check-boundary does not read. A closing line
# that is neither a trailer nor a link is left to the writer.

set -eu

# --record is the exception, so a caller that forgets it gets the stricter rule. --stored reads a
# message git has already stored, where a `#` line is part of it.
MODE=engine
STORED=no
while :; do
    case "${1:-}" in
        --record) MODE=record ;;
        --stored) STORED=yes ;;
        *) break ;;
    esac
    shift
done
MSG_FILE="${1:?usage: check-message-metadata [--record] [--stored] <message-file>}"

# Said on every message however the check ends, because a silent pass reads like a complete one.
trap 'echo "  not examined: a closing line that is neither a trailer nor a link (left to the writer)" >&2' EXIT

# An allowlist, so a key nobody has thought of is already refused.
ALLOWED='bench'

# Being written, everything from `commit -v`'s scissors line down is the diff and the `#` lines go,
# as git drops both once the hook has run.
if [ "$STORED" = yes ]; then
    CLEAN=$(git stripspace < "$MSG_FILE")
else
    CLEAN=$(sed '/^# -* >8 -*$/,$d' "$MSG_FILE" | git stripspace --strip-comments)
fi

# git's own parse, so this agrees with git, and it catches the lower-case keys
# the pass below misses. No divider, so a `---` rule cannot end the parse early.
KEYS=$(
    printf '%s\n' "$CLEAN" |
    git interpret-trailers --parse --no-divider |
    sed -n 's/^\([A-Za-z][A-Za-z0-9-]*\)[ ]*:.*/\1/p' |
    tr '[:upper:]' '[:lower:]'
)

rc=0

for key in $KEYS; do
    allowed=0
    for ok in $ALLOWED; do
        if [ "$key" = "$ok" ]; then
            allowed=1
        fi
    done
    if [ "$allowed" -eq 0 ]; then
        echo "commit message: \"$key\" is not a trailer key this repository uses." >&2
        rc=1
    fi
done

# Every line but the subject, because git reads only the last paragraph; a
# capitalised key is what separates a trailer from prose that wrapped at a colon.
# A pull request's merge carries its title on line 3, where it is a subject too.
TITLE=0
if printf '%s\n' "$CLEAN" | head -n 1 | grep -qE '^Merge pull request #[0-9]+ from '; then
    TITLE=3
fi
BODY=$(printf '%s\n' "$CLEAN" | awk -v title="$TITLE" 'NR > 1 && NR != title')
ANYWHERE=$(
    printf '%s\n' "$BODY" |
    sed -n 's/^\([A-Z][A-Za-z0-9-]*\)[ ]*:[ 	].*/\1/p' |
    tr '[:upper:]' '[:lower:]'
)
# A public message also refuses a key run up against its value, and a hyphenated lower-case key,
# the shape of a tool's trailer, where prose rarely opens a line.
if [ "$MODE" = engine ]; then
    ANYWHERE="$ANYWHERE $(
        printf '%s\n' "$BODY" |
        sed -n -e 's/^\([A-Z][A-Za-z0-9-]*\)[ ]*:[^ 	/].*/\1/p' \
            -e 's/^\([a-z][a-z0-9]*-[a-z0-9-]*\)[ ]*:.*/\1/p' |
        tr '[:upper:]' '[:lower:]'
    )"
fi

for key in $ANYWHERE; do
    allowed=0
    for ok in $ALLOWED; do
        if [ "$key" = "$ok" ]; then
            allowed=1
        fi
    done
    if [ "$allowed" -eq 0 ]; then
        echo "commit message: \"$key\" is not a trailer key this repository uses." >&2
        echo "            It is not in the trailer block, so \`git interpret-trailers\`" >&2
        echo "            does not see it. This check reads every line for that reason." >&2
        echo "            If the line is prose, write it so it does not open \"Word:\"." >&2
        rc=1
    fi
done

# Links are refused because their targets are someone else's to change. A public message also
# refuses an address and a host named without its scheme, which still point somewhere.
LINK='[a-z][a-z0-9+.-]*://|www\.[a-z0-9-]+\.[a-z]'
if [ "$MODE" = engine ]; then
    LINK="$LINK|mailto:|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}"
    LINK="$LINK|(^|[^A-Za-z0-9_./-])[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z]{2,}/[A-Za-z0-9_~]"
fi
FOUND=$(printf '%s\n' "$CLEAN" | grep -inE "$LINK" | head -n 1 || true)
if [ -n "$FOUND" ]; then
    echo "commit message: a link on line $FOUND" >&2
    rc=1
fi

# One digit is a square, not a finding.
if [ "$MODE" = engine ]; then
    # `ADR` bare or with its number in any case, and `F` only as a capital, since `f64` is a type.
    CITE=$({
        printf '%s\n' "$CLEAN" | grep -nE '(^|[^A-Za-z0-9_])ADRs?([^A-Za-z_]|$)' || true
        printf '%s\n' "$CLEAN" | grep -inE '(^|[^A-Za-z0-9_])adrs?[- ]*[0-9]' || true
        printf '%s\n' "$CLEAN" | grep -nE '(^|[^A-Za-z0-9_])F[0-9]{2,3}([^A-Za-z0-9_]|$)' || true
    } | sort -n | head -n 1)
    if [ -n "$CITE" ]; then
        echo "commit message: a record or finding citation on line $CITE" >&2
        echo "            This tree does not hold the records, so write the reason instead." >&2
        rc=1
    fi
fi
# A body sent without its subject reaches this hook with the body's first
# paragraph as the subject, so the subject is refused unless it is one line.
SUBJECT_LINES=$(printf '%s\n' "$CLEAN" | awk 'NF == 0 { exit } { n++ } END { print n + 0 }')
if [ "$SUBJECT_LINES" -eq 0 ]; then
    echo "commit message: no subject." >&2
    rc=1
elif [ "$SUBJECT_LINES" -gt 1 ]; then
    echo "commit message: the subject runs to $SUBJECT_LINES lines; it is one line, then a blank line." >&2
    rc=1
fi

if [ "$rc" -eq 0 ]; then
    # A check that cannot see a case says so on every pass, or a pass reads as having seen it.
    echo "commit message: passed. A one-line body sent without its subject reads as a subject here and is not detected." >&2
    exit 0
fi

echo "" >&2
echo "            A message here carries the subject, the body, and a trailer" >&2
echo "            block using the keys in \`check-message-metadata\`. References" >&2
echo "            are named rather than linked." >&2
echo "" >&2
echo "            This repository is published, and a message is published with" >&2
echo "            it. Unlike a file it cannot be corrected by the next commit:" >&2
echo "            the only fix is to rewrite history, and once the branch is" >&2
echo "            somewhere else that is no fix. So the line comes out before" >&2
echo "            the commit, not after." >&2
exit "$rc"
